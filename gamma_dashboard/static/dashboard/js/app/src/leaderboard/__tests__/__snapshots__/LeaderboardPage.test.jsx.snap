[
  <div
    className="gamification-title-wrapper d-flex justify-content-between align-items-center"
  >
    <h1
      data-testid="leaderboard-page-title"
      id="leaderboard-page-title"
      tabIndex={-1}
    >
      Leaderboard
    </h1>
    <div
      className="pgn__dropdown pgn__dropdown-light logo-dropdown dropdown"
      data-testid="dropdown"
    >
      <button
        aria-expanded={false}
        aria-haspopup={true}
        className="btn-logo btn btn-tertiary"
        disabled={false}
        id="logo-dropdown"
        onClick={[Function]}
        type="button"
      >
        <img
          alt="Analytics logo"
          className="logo-dropdown-img"
          src={{}}
        />
        <span
          className="pgn__icon"
          variant="tertiary"
        >
          <svg
            aria-hidden={true}
            fill="none"
            focusable={false}
            height={24}
            role="img"
            viewBox="0 0 24 24"
            width={24}
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m7 10 5 5 5-5H7Z"
              fill="currentColor"
            />
          </svg>
        </span>
      </button>
    </div>
  </div>,
  <div
    className="leaderboard-table"
    data-testid="leaderboard-table"
  >
    <div
      className="loader"
    >
      <div
        className="pgn__spinner spinner-border"
        role="status"
      >
        <span
          className="sr-only"
        >
          Loading...
        </span>
      </div>
    </div>
  </div>,
]
`;

