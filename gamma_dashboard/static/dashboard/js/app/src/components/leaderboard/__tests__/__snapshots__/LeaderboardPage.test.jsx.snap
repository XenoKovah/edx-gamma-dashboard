            data-testid="username"
          >
            
          </span>
          <div
            className="StudentInfo-Status"
            data-testid="userstatus"
          >
            No status so far
          </div>
        </span>
      </div>
      <div
        className="LeaderboardTable-Cell LeaderboardTable-Cell_progress"
        data-testid="progress-cell"
      >
        0
      </div>
      <div
        className="LeaderboardTable-Cell LeaderboardTable-Cell_badges"
        data-testid="badges-cell"
      >
        <div
          className="Badges"
        >
          No badges yet...
        </div>
      </div>
    </div>
  </div>,
]
`;
